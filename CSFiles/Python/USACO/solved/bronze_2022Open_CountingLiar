numCow = int(input())
cows = {}
for i in range(numCow):
    cows[i] = input().split()
    cows[i][1] = int(cows[i][1])
    cows[i].append(1)
    for n in range(i):
        if cows[i][0] == cows[n][0]:
            if cows[n][0] == 'G':
                if cows[n][1] > cows[i][1]:
                    cows[n][2] += 1
                elif cows[n][1] < cows[i][1]:
                    cows[i][2] += 1
                else:
                    cows[i][2] += 1
                    cows[n][2] += 1
            else:
                if cows[n][1] < cows[i][1]:
                    cows[n][2] += 1
                elif cows[n][1] > cows[i][1]:
                    cows[i][2] += 1
                else:
                    cows[i][2] += 1
                    cows[n][2] += 1
        elif cows[i][1] >= cows[n][1] and cows[n][0] == 'G':
            cows[i][2] += 1
            cows[n][2] += 1
        elif cows[i][1] <= cows[n][1] and cows[n][0] == 'L':
            cows[i][2] += 1
            cows[n][2] += 1

maximum = 0
for i in range(numCow):
    if maximum < cows[i][2]:
        maximum = cows[i][2]

print(numCow - maximum)