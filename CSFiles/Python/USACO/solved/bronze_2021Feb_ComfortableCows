numCows = int(input())
comfortable = {}
position = {}
count = 0
for i in range(numCows):
    comfortable[i] = 0
    p = [int(x) for x in input().split()]
    x = p[0]
    y = p[1]
    if x in position.keys():
        position[x][y] = 0
    else:
        position[x] = {y:0}
    
    adjacent = [[x-1, y], [x+1, y], [x, y-1], [x, y+1]]

    for a in adjacent:
        if a[0] in position.keys() and a[1] in position[a[0]].keys():
            position[a[0]][a[1]] += 1
            position[x][y] += 1
    
            if position[x][y] == 3:
                count += 1
            elif position[x][y] == 4:
                count -= 1
            if position[a[0]][a[1]] == 3:
                count += 1
            elif position[a[0]][a[1]] == 4:
                count -= 1
        
    print(count)
        